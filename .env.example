# Docker-only session configuration template. Never put PayPal credentials here.
# The native Linux launcher creates its private dashboard token automatically.
# For Docker, generate a fresh token as shown in README.md; do not use this sample.
QS_API_TOKEN=REPLACE_WITH_A_NEW_RANDOM_64_HEX_CHARACTER_VALUE
QS_MERCHANT_ID=merchant_local
PAYPAL_ENVIRONMENT=sandbox

# Optional settings. Keep previous key files so historical signatures can be verified.
# QS_KEY_ID=payment-key-2
# QS_KEY_DIR=/var/lib/quantum-shield/payment-pq-keys
